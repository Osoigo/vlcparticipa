<p id="unidad">
  <strong>
    <%= t("valuation.budget_investments.show.service") %>:
  </strong>
  <% if investment.unidad.present? %>
    <%= investment.unidad %>
  <% else %>
    <%= t("valuation.budget_investments.show.undefined") %>
  <% end %>
</p>
<p id="other_services">
  <strong>
    <%= t("valuation.budget_investments.show.other_services") %>:
  </strong>
  <% if investment.other_services.present? %>
    <%= investment.other_services %>
  <% else %>
    <%= t("valuation.budget_investments.show.undefined") %>
  <% end %>
</p>
<% if budget.show_money? %>
  <p id="price">
    <strong>
      <%= t("valuation.budget_investments.show.price_with_currency",
            currency: budget.currency_symbol) %>:
    </strong>
    <% if investment.price.present? %>
      <%= investment.price %>
    <% else %>
      <%= t("valuation.budget_investments.show.undefined") %>
    <% end %>
  </p>
  <p id="allows_phase">
    <strong>
      <%= t("valuation.budget_investments.show.allows_phase") %>
    </strong>
    <% if investment.allows_phase %>
      <%= t("valuation.budget_investments.show.active") %>
    <% else %>
      <%= t("valuation.budget_investments.show.inactive") %>
    <% end %>
  </p>
  <% if investment.allows_phase %>
    <p id="price_phase1">
      <strong>
        <%= t("valuation.budget_investments.show.price_phase1_with_currency",
              currency: budget.currency_symbol) %>
      </strong>
      <% if investment.price_phase1.present? %>
        <%= investment.price_phase1 %>
      <% else %>
        <%= t("valuation.budget_investments.show.undefined") %>
      <% end %>
    </p>
    <p id="price_phase2">
      <strong>
        <%= t("valuation.budget_investments.show.price_phase2_with_currency",
              currency: budget.currency_symbol) %>
      </strong>
      <% if investment.price_phase2.present? %>
        <%= investment.price_phase2 %>
      <% else %>
        <%= t("valuation.budget_investments.show.undefined") %>
      <% end %>
    </p>
    <p id="price_phase3">
      <strong>
        <%= t("valuation.budget_investments.show.price_phase3_with_currency",
              currency: budget.currency_symbol) %>
      </strong>
      <% if investment.price_phase3.present? %>
        <%= investment.price_phase3 %>
      <% else %>
        <%= t("valuation.budget_investments.show.undefined") %>
      <% end %>
    </p>
    <p id="price_phase4">
      <strong>
        <%= t("valuation.budget_investments.show.price_phase4_with_currency",
              currency: budget.currency_symbol) %>
      </strong>
      <% if investment.price_phase4.present? %>
        <%= investment.price_phase4 %>

      <% else %>
        <%= t("valuation.budget_investments.show.undefined") %>
      <% end %>
    </p>
  <% end %>
  <p id="budget_implementation">
    <strong><%= t("valuation.budget_investments.show.budget_implementation") %>:</strong>
    <% if investment.budget_implementation.present? %>
      <%= investment.budget_implementation %>
    <% else %>
      <%= t("valuation.budget_investments.show.undefined") %>
    <% end %>
  </p>
  <p class="hide" id="price_first_year">
    <strong>
      <%= t("valuation.budget_investments.show.price_first_year_with_currency",
            currency: budget.currency_symbol) %>:
    </strong>
    <% if investment.price_first_year.present? %>
      <%= investment.price_first_year %>
    <% else %>
      <%= t("valuation.budget_investments.show.undefined") %>
    <% end %>
  </p>
<% end %>
<%= explanation_field investment.price_explanation %>
<p id="duration">
  <strong><%= t("valuation.budget_investments.show.duration") %>:</strong>
  <% if investment.duration.present? %>
    <%= investment.duration %>
  <% else %>
    <%= t("valuation.budget_investments.show.undefined") %>
  <% end %>
</p>
<p id="feasibility">
  <strong><%= t("valuation.budget_investments.show.feasibility") %>:</strong>
  <%= t("valuation.budget_investments.show.#{investment.feasibility}") %>
</p>
<%= explanation_field investment.unfeasibility_explanation %>
<% if investment.valuation_finished %>
  <p id="valuation">
    <strong><%= t("valuation.budget_investments.show.valuation_finished") %></strong>
  </p>
<% end %>
